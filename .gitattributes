* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.ini text eol=lf
*.uproject text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.png binary

# Unreal binary content is stored with Git LFS. Added ahead of importing any
# marketplace/Fab kit; existing small PNG concept art stays a normal blob.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
